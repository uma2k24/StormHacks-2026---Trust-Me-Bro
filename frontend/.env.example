# Copy to .env.local and fill in. Without keys the app plays the built-in mock show.

# Gemini writes the briefing (with Google Search grounding for scores and news).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ElevenLabs reads it aloud and transcribes answers.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=XcXEQzuLXRU9RcfWzEJt
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_STT_MODEL_ID=scribe_v2
# ELEVENLABS_STT_LANGUAGE=en

# Conversation replies: "on" (default) uses Google Search when useful;
# "fresh" limits search to sports and local; "off" turns search off.
# CONVERSATION_SEARCH=fresh

# Fallback location when a listener gave no town. Weather comes from Open-Meteo (no key).
# BRIEFING_CITY=Burnaby
# BRIEFING_LAT=49.2838
# BRIEFING_LON=-122.7932
# BRIEFING_TIMEZONE=America/Vancouver
